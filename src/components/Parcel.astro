---
/* A project as a courier parcel: tracking number, status, the delivery
   road that fills along the release dates, the four steps and the real
   release log. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { shipping, shortDate } from '../lib/work';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Home shows a short log and links to the full tracking page. */
  compact?: boolean;
  /** Heading level for the project name. */
  level?: 'h1' | 'h3';
}

const { entry, compact = false, level = 'h3' } = Astro.props;
const ship = shipping(entry.data.releases);
const Title = level;
const number = ship
  ? `${entry.data.title.toUpperCase()}-${ship.latest.version}`
  : entry.data.title.toUpperCase();

// Newest first. Home shows the latest four and the first.
const newest = ship ? [...ship.stops].reverse() : [];
const shown =
  compact && newest.length > 5
    ? [...newest.slice(0, 4), newest[newest.length - 1]]
    : newest;
const hidden = newest.length - shown.length;
const steps = ['Built', 'Tested', 'Released', 'Delivered'];
const video = entry.data.video;
---

<article class:list={['parcel', { 'parcel--full': !compact }]} data-parcel>
  <header class="parcel-top">
    <div class="parcel-id">
      <span class="parcel-label mono">Tracking no.</span>
      <span class="parcel-number mono">{number}</span>
    </div>
    <span class:list={['parcel-status', { 'parcel-status--transit': !ship }]}>
      {ship ? 'Delivered' : 'In transit'}
    </span>
  </header>

  <div class="parcel-body">
    <div class="parcel-head">
      <Title class="parcel-title">
        <span style={`view-transition-name: title-${entry.id}`}>
          {entry.data.title}
        </span>
      </Title>
      <p class="parcel-year mono" data-year>
        <time datetime={String(entry.data.year)}>{entry.data.year}</time>
      </p>
    </div>
    <p class="parcel-pitch">{entry.data.pitch}</p>

    {ship && (
      <>
        <ol class="steps" aria-label="Delivery steps, all done">
          {steps.map((step, i) => (
            <li style={`--s:${i}`}>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" />
              </svg>
              {step}
            </li>
          ))}
        </ol>

        <div class="road" data-road aria-hidden="true">
          <span class="road-track" />
          <span class="road-fill" />
          {ship.stops.map((stop) => (
            <span class="road-tick" style={`--at:${stop.at}`} />
          ))}
          <span class="road-head" />
        </div>
        <p class="road-ends mono" aria-hidden="true">
          <span>{shortDate(ship.first.date)}</span>
          <span>{shortDate(ship.latest.date, true)}</span>
        </p>

        <ol
          class="log"
          aria-label={`${entry.data.title} releases, newest first`}
        >
          {shown.map((stop, i) => (
            <li
              class:list={['log-row', { 'log-row--latest': i === 0 }]}
              tabindex="0"
              data-at={stop.at}
            >
              <span class="log-date mono">{shortDate(stop.date, true)}</span>
              <span class="log-dot" aria-hidden="true" />
              <span class="log-text">
                <span class="log-version mono">{stop.version}</span> {stop.note}
              </span>
            </li>
          ))}
          {hidden > 0 && (
            <li class="log-more">+ {hidden} more releases in between</li>
          )}
        </ol>
      </>
    )}

    <figure class="proof" data-clip-box>
      <div
        class="proof-photo"
        style={`view-transition-name: cover-${entry.id}; view-transition-class: cover`}
      >
        {video ? (
          <>
            <video
              class:list={['proof-video', { 'proof-video--wide': video.phone }]}
              data-clip
              muted
              loop
              playsinline
              preload="none"
              width={video.width}
              height={video.height}
              poster={video.poster}
              aria-label={video.label}
            >
              <source src={video.src} type="video/mp4" />
            </video>
            {video.phone && (
              <video
                class="proof-video proof-video--phone"
                data-clip
                muted
                loop
                playsinline
                preload="none"
                width={video.phone.width}
                height={video.phone.height}
                poster={video.phone.poster}
                aria-label={video.label}
              >
                <source src={video.phone.src} type="video/mp4" />
              </video>
            )}
          </>
        ) : (
          <Image
            src={entry.data.cover}
            alt={entry.data.coverAlt}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 80rem) 60rem, 90vw"
            class="proof-img"
            loading={compact ? 'lazy' : 'eager'}
            fetchpriority={compact ? 'auto' : 'high'}
          />
        )}
      </div>
      <div class="proof-foot">
        <figcaption>Proof of delivery. Screens show sample data.</figcaption>
        {video && (
          <button
            type="button"
            class="proof-toggle"
            data-clip-toggle
            data-paused="false"
            hidden
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <g class="i-pause">
                <rect x="3.5" y="2.5" width="3" height="11" rx="1" />
                <rect x="9.5" y="2.5" width="3" height="11" rx="1" />
              </g>
              <path
                class="i-play"
                d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8-5.2a.8.8 0 0 0 0-1.4l-8-5.2a.8.8 0 0 0-1.2.7Z"
              />
            </svg>
            <span>Pause video</span>
          </button>
        )}
      </div>
    </figure>

    {compact && (
      <p class="parcel-actions">
        <a href={`/work/${entry.id}/`} class="button">
          Full tracking details
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
        <a
          href={entry.data.repo}
          class="parcel-repo"
          rel="noopener"
          target="_blank"
        >
          Source on GitHub
        </a>
      </p>
    )}
  </div>

  <footer class="parcel-foot">
    <span>
      <span class="mono">
        {ship
          ? `${ship.count} releases in ${ship.days} days · ${shortDate(ship.first.date)}–${shortDate(ship.latest.date, true)}`
          : `${entry.data.year}`}
      </span>
      {' · '}
      {entry.data.stack.join(', ')}
    </span>
    <span class="barcode" aria-hidden="true"></span>
  </footer>
</article>

<style>
  .parcel {
    background: var(--card);
    border-radius: 18px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .parcel-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1rem clamp(1rem, 3vw, 1.75rem);
    background: var(--indigo);
    color: var(--on-indigo);
  }

  .parcel-id {
    display: grid;
    gap: 0.1rem;
  }

  .parcel-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-indigo-soft);
  }

  .parcel-number {
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.2rem);
    overflow-wrap: anywhere;
  }

  .parcel-status {
    padding: 0.4rem 1rem;
    border: 2px solid var(--stamp);
    border-radius: 999px;
    background: var(--stamp);
    color: var(--ink);
    font-weight: 900;
    font-stretch: 112%;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Yellow is earned: only a delivered parcel gets the stamp. */
  .parcel-status--transit {
    background: transparent;
    border-color: var(--on-indigo-soft);
    border-style: dashed;
    color: var(--on-indigo);
  }

  .parcel-body {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 3vw, 1.75rem);
  }

  .parcel-body > * {
    min-width: 0;
  }

  .parcel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .parcel-title {
    font-weight: 900;
    font-stretch: 120%;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .parcel-title span {
    display: inline-block;
  }

  .parcel--full .parcel-title {
    font-size: clamp(3.5rem, 12vw, 6rem);
  }

  .parcel-year {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }

  .parcel-pitch {
    max-width: 36rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.35;
    font-weight: 600;
  }

  /* ——— the road ——— */
  .road {
    --pos: 1;
    --head: 18px;
    position: relative;
    height: 1.5rem;
    margin-top: 0.25rem;
  }

  .road-track,
  .road-fill {
    position: absolute;
    left: 0;
    bottom: 0.4rem;
    height: 4px;
    border-radius: 2px;
  }

  .road-track {
    right: 0;
    background: var(--hair);
  }

  .road-fill {
    width: calc(var(--pos) * 100%);
    background: var(--action);
    transition: width 700ms var(--ease-out);
  }

  .road-tick {
    position: absolute;
    bottom: calc(0.4rem - 3px);
    left: calc(var(--at) * (100% - 10px));
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--action);
  }

  /* The leading edge of the delivery: a glowing marker on the line. */
  .road-head {
    position: absolute;
    bottom: calc(0.4rem + 2px - var(--head) / 2);
    left: calc(var(--pos) * (100% - var(--head)));
    width: var(--head);
    height: var(--head);
    border-radius: 50%;
    background: var(--action);
    border: 3px solid var(--card);
    box-shadow:
      0 0 0 4px rgb(176 35 110 / 0.18),
      0 2px 6px rgb(29 20 56 / 0.3);
    transition: left 700ms var(--ease-out);
  }

  /* The four checkpoints: a status row of their own, not tied to dates. */
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--indigo);
  }

  .steps li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem 0.3rem 0.45rem;
    border: 1.5px solid var(--indigo);
    border-radius: 999px;
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out);
  }

  .steps svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .steps li:last-child {
    background: var(--indigo);
    color: var(--on-indigo);
  }

  /* On narrow phones, two by two so Delivered never sits alone. */
  @media (max-width: 480px) {
    .steps {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps li {
      justify-content: center;
    }
  }

  .road-ends {
    display: flex;
    justify-content: space-between;
    margin-top: -0.85rem;
    font-size: 0.72rem;
    color: var(--muted);
  }

  /* ——— the log ——— */
  .log {
    display: grid;
    border-top: 1px solid var(--hair);
  }

  .log-row,
  .log-more {
    display: grid;
    grid-template-columns: 7rem 1.25rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.55rem 0.5rem;
    border-radius: 10px;
    font-size: 0.95rem;
  }

  .log-row {
    cursor: default;
    transition: background-color 200ms var(--ease-out);
  }

  .log-row:hover,
  .log-row:focus-visible {
    background: var(--card-soft);
  }

  .log-date {
    font-size: 0.78rem;
    color: var(--muted);
    padding-top: 0.15rem;
  }

  .log-dot {
    justify-self: center;
    width: 10px;
    height: 10px;
    margin-top: 0.45rem;
    border-radius: 50%;
    background: var(--dash);
    transition: background-color 200ms var(--ease-out);
  }

  .log-row--latest .log-dot,
  .log-row:hover .log-dot,
  .log-row:focus-visible .log-dot {
    background: var(--action);
    box-shadow: 0 0 0 4px rgb(176 35 110 / 0.16);
  }

  .log-version {
    font-weight: 700;
    color: var(--indigo);
  }

  .log-more {
    grid-template-columns: 1fr;
    padding-left: calc(7rem + 2.5rem);
    font-size: 0.78rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .log-row {
      grid-template-columns: 1.25rem minmax(0, 1fr);
      gap: 0.15rem 0.6rem;
    }

    .log-date {
      grid-column: 2;
      padding-top: 0;
    }

    .log-dot {
      grid-row: 1;
      grid-column: 1;
    }

    .log-text {
      grid-column: 2;
    }

    .log-more {
      padding-left: 2.35rem;
    }
  }

  /* ——— proof of delivery ——— */
  .proof {
    display: grid;
    gap: 0.6rem;
  }

  .proof-photo {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--hair);
    background: var(--indigo);
  }

  .proof-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Home shows the phones only; the cover's own title plate would repeat
     the parcel's title. The full plate stays on the tracking page. */
  .parcel:not(.parcel--full) .proof-img {
    aspect-ratio: 3600 / 1500;
    object-fit: cover;
    object-position: 50% 100%;
  }

  /* On phones, zoom in on the middle three phones so their screens read. */
  @media (max-width: 600px) {
    .parcel:not(.parcel--full) .proof-photo:has(.proof-img) {
      position: relative;
      aspect-ratio: 3 / 2;
    }

    .parcel:not(.parcel--full) .proof-img {
      position: absolute;
      left: 50%;
      bottom: 0;
      width: 170%;
      max-width: none;
      aspect-ratio: auto;
      translate: -50% 0;
    }
  }

  .proof-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }

  /* The wide clip on larger screens, the portrait phone cut under 600px. */
  .proof-video--phone {
    display: none;
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 600px) {
    .proof-video--wide {
      display: none;
    }

    .proof-video--phone {
      display: block;
    }
  }

  /* Caption and the stop control (WCAG 2.2.2), under the frame so the
     button never covers the screens. */
  .proof-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  /* A media control, not an action: no outline, so it never competes
     with the parcel's button. */
  .proof-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    margin-inline: -0.5rem;
    padding: 0.4rem 0.5rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .proof-toggle:hover {
    color: var(--action);
  }

  .proof-toggle[hidden] {
    display: none;
  }

  .proof-toggle svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  .proof-toggle .i-play,
  .proof-toggle[data-paused='true'] .i-pause {
    display: none;
  }

  .proof-toggle[data-paused='true'] .i-play {
    display: inline;
  }

  .proof figcaption {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .parcel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .parcel-repo {
    font-weight: 700;
  }

  .parcel-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.9rem clamp(1rem, 3vw, 1.75rem);
    border-top: 1.5px dashed var(--dash);
    background: var(--card-soft);
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* ——— the drive, when the script arms it ——— */
  :global(.drive) .parcel:not(.is-driving) .road {
    --pos: 0;
  }

  /* Before the stamp: an empty outline, still readable on indigo. */
  :global(.drive) .parcel:not(.is-driving) .parcel-status {
    background: transparent;
    color: var(--on-indigo);
    border-style: dashed;
    transform: scale(0.92) rotate(-4deg);
  }

  :global(.drive) .parcel:not(.is-driving) .steps li {
    border-style: dashed;
    border-color: var(--muted);
    background: transparent;
    color: var(--muted);
  }

  :global(.drive) .road-fill,
  :global(.drive) .road-head {
    transition-duration: 2.4s;
    transition-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
  }

  :global(.drive) .parcel.is-settled .road-fill,
  :global(.drive) .parcel.is-settled .road-head {
    transition-duration: 600ms;
    transition-timing-function: var(--ease-out);
  }

  :global(.drive) .steps li {
    transition-delay: calc(var(--s) * 700ms + 200ms);
  }

  :global(.drive) .parcel-status {
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      transform 350ms var(--ease-out);
    transition-delay: 2.5s;
  }
</style>
