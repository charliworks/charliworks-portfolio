---
/* A parol lantern: the favicon's four-point sparkle hung on a string,
   with two short tails. Purely decorative. */
interface Props {
  /** Lantern width in rem. */
  size: number;
  /** String length in rem. */
  drop: number;
  /** Swing start offset, in ms, so lanterns don't move in step. */
  delay?: number;
  class?: string;
}

const { size, drop, delay = 0, class: className } = Astro.props;
---

<span
  class:list={['parol', className]}
  style={`--size:${size}rem;--drop:${drop}rem;--delay:${delay}ms`}
  aria-hidden="true"
>
  <span class="parol-string"></span>
  <svg viewBox="0 0 40 56" class="parol-star">
    <path
      class="parol-tail"
      d="M17 36 Q15 46 12 55 M23 36 Q25 46 28 55"
      fill="none"
      stroke-width="1.6"
      stroke-linecap="round"
    ></path>
    <path
      class="parol-body"
      d="M20 0 Q22 18 40 20 Q22 22 20 40 Q18 22 0 20 Q18 18 20 0Z"
    ></path>
    <path
      class="parol-core"
      d="M20 9 Q21 19 31 20 Q21 21 20 31 Q19 21 9 20 Q19 19 20 9Z"
    ></path>
  </svg>
</span>

<style>
  .parol {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: var(--size);
    transform-origin: top center;
    animation: hang 3.6s var(--ease-out) both;
    animation-delay: var(--delay);
  }

  .parol-string {
    width: 1px;
    height: var(--drop);
    /* The string fades in from the dark, so it never starts abruptly. */
    background: linear-gradient(to bottom, transparent, var(--string) 45%);
  }

  .parol-star {
    width: 100%;
    height: auto;
    margin-top: -1px;
    overflow: visible;
    filter: var(--glow);
    transition: filter 500ms var(--ease-out);
  }

  /* With the script on, a lantern can be tapped to set it swinging. */
  :global(.lanterns-live) .parol-star {
    pointer-events: auto;
    cursor: pointer;
  }

  .parol:global(.is-lit) .parol-star {
    filter: drop-shadow(0 0 26px rgb(255 224 102 / 0.95));
    transition-duration: 120ms;
  }

  .parol-body {
    fill: var(--yellow);
  }

  .parol-core {
    fill: #fff6c4;
  }

  .parol-tail {
    stroke: var(--pink);
  }

  /* Just hung: a few damped swings, then still. */
  @keyframes hang {
    0% {
      transform: rotate(9deg);
    }
    22% {
      transform: rotate(-6deg);
    }
    44% {
      transform: rotate(3.5deg);
    }
    66% {
      transform: rotate(-1.5deg);
    }
    84% {
      transform: rotate(0.5deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }
</style>
