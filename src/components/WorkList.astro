---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
---

<ul class="work">
  {entries.map((entry) => (
    <li class="capiz project">
      <div
        class="cover"
        style={`view-transition-name: cover-${entry.id}; view-transition-class: cover`}
      >
        <Image
          src={entry.data.cover}
          alt={entry.data.coverAlt}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 80rem) 72rem, 92vw"
          class="cover-img"
        />
      </div>
      <div class="project-meta">
        <div class="project-head">
          <a href={`/work/${entry.id}/`} class="project-title">
            <span style={`view-transition-name: title-${entry.id}`}>
              {entry.data.title}
            </span>
          </a>
          <time datetime={String(entry.data.year)}>{entry.data.year}</time>
        </div>
        <div class="project-copy">
          <p class="project-pitch">{entry.data.pitch}</p>
          <p class="project-stack">{entry.data.stack.join(' · ')}</p>
        </div>
      </div>
    </li>
  ))}
</ul>

<style>
  .work {
    display: grid;
    gap: 2rem;
  }

  /* The project is one lit card; the whole card is the click target. */
  .project {
    position: relative;
    padding: clamp(0.6rem, 1.5vw, 1rem);
  }

  .cover {
    overflow: hidden;
    border-radius: 16px;
    background: var(--indigo);
  }

  /* Home shows the phones only; the cover's own title plate would repeat
     the card's title. The full plate stays on the case page. */
  .cover-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3600 / 1500;
    object-fit: cover;
    object-position: 50% 100%;
  }

  .project-meta {
    display: grid;
    gap: 1rem 3rem;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(0.5rem, 2vw, 1.25rem)
      clamp(0.75rem, 2vw, 1.25rem);
  }

  .project-meta > * {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .project-meta {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
  }

  .project-title {
    font-weight: 800;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--yellow);
    text-decoration: none;
  }

  .project-title span {
    display: inline-block;
    text-shadow: 0 0 28px rgb(255 224 102 / 0.3);
  }

  .project-title::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 22px;
  }

  .project-title:focus-visible {
    outline: none;
  }

  .project-title:focus-visible::after {
    outline: 2px solid var(--yellow);
    outline-offset: 4px;
  }

  .project-head time {
    font-weight: 700;
    color: var(--mist);
  }

  .project-pitch {
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.3;
    font-weight: 700;
    color: var(--moon);
  }

  .project-stack {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--mist);
  }
</style>
