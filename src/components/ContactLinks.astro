---
import { site } from '../site';
import { contactLinks } from '../lib/contact';

const links = contactLinks(site);
const email = links.find((l) => l.label === 'Email');
const others = links.filter((l) => l !== email);
const [user, domain] = site.email.split('@');
---

<div class="contact-links">
  {email && (
    <a href={email.href} class="contact-email">
      {user}
      <wbr />@{domain}
    </a>
  )}
  <ul class="contact-others">
    {others.map((link) => (
      <li>
        <a href={link.href} class="button" rel="noopener" target="_blank">
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .contact-links {
    display: grid;
    gap: 1.25rem;
  }

  .contact-email {
    font-weight: 900;
    font-stretch: 105%;
    font-size: clamp(1.3rem, 4.2vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--action);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    overflow-wrap: anywhere;
  }

  .contact-email:hover,
  .contact-email:focus-visible {
    color: var(--indigo);
    text-decoration-color: var(--indigo);
  }

  .contact-others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>
