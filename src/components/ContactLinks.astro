---
import { site } from '../site';
import { contactLinks } from '../lib/contact';

const links = contactLinks(site);
const email = links.find((l) => l.label === 'Email');
const others = links.filter((l) => l !== email);
const [user, domain] = site.email.split('@');
---

<div class="contact-links">
  {email && (
    <a href={email.href} class="contact-email">
      {user}
      <wbr />@{domain}
    </a>
  )}
  <ul class="contact-others">
    {others.map((link) => (
      <li>
        <a href={link.href} rel="noopener" target="_blank">
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .contact-links {
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  /* The brightest thing on the page: lit by the lantern above it. */
  .contact-email {
    font-weight: 800;
    font-size: clamp(1.4rem, 4.6vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--yellow);
    text-shadow: 0 0 28px rgb(255 224 102 / 0.35);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    text-decoration-color: rgb(255 224 102 / 0.45);
    overflow-wrap: anywhere;
  }

  .contact-email:hover,
  .contact-email:focus-visible {
    text-decoration-color: var(--pink);
    text-decoration-thickness: 3px;
  }

  .contact-others {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    font-weight: 700;
    font-size: var(--text-lg);
  }
</style>
