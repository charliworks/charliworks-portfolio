---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import Parol from '../components/Parol.astro';
import Spark from '../components/Spark.astro';
import { Content as About } from '../content/about.md';
import { site } from '../site';
import { sortWork } from '../lib/work';
import { jobDates } from '../lib/experience';

const work = sortWork(await getCollection('work'));
const lead = work[0];
const now = site.experience[0];
---

<Base
  title={site.name}
  description={`${site.name}, full-stack developer. ${site.openTo}`}
>
  <section class="hero" aria-labelledby="name">
    <div class="lanterns">
      <Parol size={5} drop={3} delay={0} />
      <Parol size={3.2} drop={8} delay={260} />
      <Parol size={4.2} drop={1.5} delay={520} />
    </div>

    <h1 id="name" class="hero-name">
      {site.name}
    </h1>
    <p class="hero-role">{site.role}</p>
    {site.intro && <p class="hero-intro">{site.intro}</p>}
    <p class="hero-brand">
      <img src="/favicon.png" alt="" width="24" height="24" />
      <span>
        I ship my projects under <a href={site.brand.url}>{site.brand.name}</a>.
      </span>
    </p>

    <ul class="hero-cards">
      {lead && (
        <li>
          <a href="#work" class="capiz hero-card hero-card--lit">
            <strong>{lead.data.title}</strong>
            <span>{lead.data.pitch}</span>
          </a>
        </li>
      )}
      {now && (
        <li>
          <a href="#experience" class="capiz hero-card">
            <strong>Experience</strong>
            <span>
              {now.role} at {now.company}
              {now.end ? '' : ` since ${now.start.slice(0, 4)}`}.
            </span>
          </a>
        </li>
      )}
      <li>
        <a href="#contact" class="capiz hero-card">
          <strong>Say hi</strong>
          <span>Email, GitHub, LinkedIn or résumé.</span>
        </a>
      </li>
    </ul>
  </section>

  <section id="work" tabindex="-1" class="stop" aria-labelledby="work-h">
    <div class="section-lantern" style="--x:12%">
      <Parol size={3} drop={5} delay={150} />
    </div>
    <h2 id="work-h" class="heading">
      <Spark />
      Work
    </h2>
    <WorkList entries={work} />
  </section>

  <section
    id="experience"
    tabindex="-1"
    class="stop"
    aria-labelledby="experience-h"
  >
    <h2 id="experience-h" class="heading">
      <Spark />
      Experience
    </h2>
    <ul class="jobs">
      {site.experience.map((job) => {
        const dates = jobDates(job.start, job.end);
        return (
          <li class="job">
            <p class="job-dates">
              <time datetime={job.start}>{dates.start}</time>–
              {job.end ? (
                <time datetime={job.end}>{dates.end}</time>
              ) : (
                'present'
              )}
            </p>
            <div class="job-main">
              <p class="job-company">
                {job.logo && (
                  <img
                    src={job.logo}
                    alt=""
                    width="36"
                    height="36"
                    class="job-logo"
                  />
                )}
                {job.url ? <a href={job.url}>{job.company}</a> : job.company}
              </p>
              <p class="job-role">{job.role}</p>
              <p class="job-summary">{job.summary}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <section id="about" tabindex="-1" class="stop" aria-labelledby="about-h">
    <h2 id="about-h" class="heading">
      <Spark />
      About
    </h2>
    <div class="about">
      <About />
    </div>
  </section>

  <section id="tools" tabindex="-1" class="stop" aria-labelledby="tools-h">
    <div class="section-lantern" style="--x:30%">
      <Parol size={2.4} drop={3.5} delay={300} />
    </div>
    <h2 id="tools-h" class="heading">
      <Spark />
      Tools
    </h2>
    <dl class="tools">
      {site.tools.map((group) => (
        <div class="capiz tool-card">
          <dt>{group.label}</dt>
          <dd>{group.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  /* ——— first viewport ——— */
  .hero {
    position: relative;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: clamp(3rem, 10vh, 6rem) clamp(1rem, 5vw, 4rem)
      clamp(2rem, 6vh, 4rem);
  }

  /* Lanterns hang from the top edge of the page, top right. */
  .lanterns {
    position: absolute;
    /* Strings start at the page's top edge, behind the header. */
    top: -4.5rem;
    right: clamp(1rem, 30vw, 28rem);
    z-index: 0;
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 3vw, 2.25rem);
    pointer-events: none;
  }

  .hero-name {
    max-width: 11ch;
    font-weight: 800;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--pink);
  }

  .hero-role {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    font-weight: 700;
    color: var(--yellow);
  }

  .hero-intro {
    margin-top: 0.75rem;
    max-width: 36rem;
    font-size: 1.2rem;
    color: var(--lavender);
  }

  .hero-brand {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--mist);
  }

  .hero-brand img {
    border-radius: 6px;
  }

  .hero-cards {
    margin-top: clamp(2rem, 5vh, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }

  .hero-card {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 1rem 1.25rem 1.15rem;
  }

  /* Habi is the first lit card. */
  .hero-card--lit {
    border-color: var(--capiz-edge-lit);
    box-shadow: 0 0 40px -12px rgb(255 224 102 / 0.45);
  }

  .hero-card strong {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--yellow);
  }

  .hero-card span {
    font-size: 1rem;
    line-height: 1.4;
    color: var(--lavender);
  }

  @media (max-width: 640px) {
    /* On phones the lanterns hang below the header, clear of the nav. */
    .lanterns {
      top: 0;
      right: 0.75rem;
      transform: scale(0.55);
      transform-origin: top right;
    }

    .hero-name {
      padding-top: 5.5rem;
    }
  }

  /* ——— sections ——— */
  .stop {
    position: relative;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: clamp(4.5rem, 12vh, 8rem) clamp(1rem, 5vw, 4rem) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vh, 3rem);
  }

  /* A lantern hung over a section, lighting what sits below it. */
  .section-lantern {
    position: absolute;
    top: 0;
    right: var(--x);
    pointer-events: none;
  }

  .section-lantern::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 60%;
    width: 36rem;
    height: 26rem;
    translate: -50% 0;
    background: radial-gradient(
      closest-side,
      rgb(255 224 102 / 0.17),
      transparent
    );
    z-index: -1;
  }

  @media (max-width: 640px) {
    .section-lantern {
      transform: scale(0.7);
      transform-origin: top center;
    }
  }

  .stop:focus {
    outline: none;
  }

  /* ——— experience ——— */
  .jobs {
    display: grid;
  }

  .job {
    display: grid;
    gap: 0.5rem 2rem;
    padding: 1.75rem 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .job:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  @media (min-width: 760px) {
    .job {
      grid-template-columns: 12rem 1fr;
      align-items: baseline;
    }
  }

  @media (max-width: 759px) {
    .job-dates {
      order: 1;
    }
  }

  .job-dates {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--mist);
  }

  .job-company {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-weight: 800;
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    line-height: 1.05;
    color: var(--moon);
  }

  .job-company a {
    text-decoration-thickness: 2px;
  }

  .job-logo {
    flex: none;
    width: clamp(1.9rem, 3vw, 2.3rem);
    height: auto;
    padding: 3px;
    border-radius: 10px;
    background: var(--moon);
    object-fit: contain;
  }

  .job-role {
    margin-top: 0.6rem;
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--yellow);
  }

  .job-summary {
    max-width: 38rem;
    color: var(--lavender);
  }

  /* ——— about ——— */
  .about {
    max-width: 52rem;
    font-weight: 600;
    font-size: clamp(1.6rem, 3.6vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--moon);
    overflow-wrap: break-word;
  }

  .about :global(p + p) {
    margin-top: 1em;
  }

  /* ——— tools ——— */
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .tool-card {
    padding: 1.1rem 1.3rem 1.25rem;
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }

  .tool-card dt {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--yellow);
  }

  .tool-card dd {
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--lavender);
  }

  @media (max-width: 480px) {
    .about {
      overflow-wrap: anywhere;
    }
  }
</style>
