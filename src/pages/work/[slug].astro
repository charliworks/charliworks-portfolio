---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Parcel from '../../components/Parcel.astro';
import { site } from '../../site';
import { sortWork } from '../../lib/work';
import { caseTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const work = sortWork(await getCollection('work'));
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={caseTitle(entry.data.title, site)}
  description={entry.data.pitch}
  image={entry.data.cover}
>
  <link slot="head" rel="expect" href="#case-parcel" blocking="render" />
  <article class="case-page">
    <p class="back">
      <a href="/#work">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M19 12H5M11 6l-6 6 6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        {site.name}
      </a>
    </p>

    <div id="case-parcel">
      <Parcel entry={entry} level="h1" />
    </div>
    {entry.data.video && (
      <figure class="case-shot">
        <Image
          src={entry.data.cover}
          alt={entry.data.coverAlt}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 76rem) 70rem, 92vw"
          class="case-shot-img"
        />
        <figcaption>
          Every screen in one view. Screens show sample data.
        </figcaption>
      </figure>
    )}

    <p class="case-label">A {site.brand.name} project.</p>

    <div class="case">
      <Content />
    </div>
  </article>
</Base>

<style>
  .case-page {
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 5vh, 3rem) clamp(1rem, 5vw, 3rem) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    text-decoration-color: transparent;
  }

  .back svg {
    width: 1.1rem;
    transition: transform 300ms var(--ease-out);
  }

  .back a:hover svg {
    transform: translateX(-4px);
  }

  /* The still: every screen at once, under the clip. */
  .case-shot {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .case-shot-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    background: var(--indigo);
    box-shadow: var(--card-shadow);
  }

  .case-shot figcaption {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .case-label {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .case {
    width: 100%;
    max-width: 42rem;
    margin: clamp(2.5rem, 7vh, 4rem) auto 0;
    overflow-wrap: break-word;
  }

  .case :global(h2) {
    margin-top: 3.25rem;
    margin-bottom: 0.4rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--ink);
    font-weight: 900;
    font-stretch: 115%;
    font-size: clamp(1.6rem, 3.6vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .case :global(h2:first-child) {
    margin-top: 0;
  }

  .case :global(p),
  .case :global(ul) {
    margin-top: 1rem;
  }

  .case :global(strong) {
    font-weight: 800;
    color: var(--indigo);
  }

  .case :global(ul) {
    padding-left: 1.4rem;
    list-style: none;
  }

  .case :global(li) {
    position: relative;
  }

  /* Each item is checked off, like a packing list. */
  .case :global(li)::before {
    content: '';
    position: absolute;
    left: -1.4rem;
    top: 0.42em;
    width: 0.8rem;
    height: 0.8rem;
    border: 1.5px solid var(--indigo);
    border-radius: 3px;
    background: linear-gradient(var(--action), var(--action)) center / 0.4rem
      0.4rem no-repeat;
  }

  .case :global(li + li) {
    margin-top: 0.5rem;
  }

  .case :global(code) {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    border-radius: 5px;
    background: var(--card);
    border: 1px solid var(--hair);
  }

  @media (max-width: 480px) {
    .case {
      overflow-wrap: anywhere;
    }
  }
</style>
