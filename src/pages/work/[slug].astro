---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../site';
import { sortWork } from '../../lib/work';

export async function getStaticPaths() {
  const work = sortWork(await getCollection('work'));
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} · ${site.name}`}
  description={entry.data.pitch}
  image={entry.data.cover}
>
  <p>
    <a href="/">{site.name}</a>
  </p>
  <h1 class="mt-10 text-lg font-medium">{entry.data.title}</h1>
  <p class="mt-1 text-text-muted">{entry.data.pitch}</p>

  <Image
    src={entry.data.cover}
    alt={entry.data.coverAlt}
    widths={[576, 1152]}
    sizes="(min-width: 36rem) 36rem, 100vw"
    class="mt-8 h-auto w-full rounded-sm"
    loading="eager"
  />
  <p class="mt-2 text-sm text-text-muted">
    Screens show sample data. {entry.data.stack.join(' · ')}
  </p>

  <div class="case mt-4">
    <Content />
  </div>
</Base>

<style>
  .case :global(h2) {
    margin-top: 3rem;
    margin-bottom: 0.75rem;
    font-weight: 500;
  }
  .case :global(p),
  .case :global(ul) {
    margin-top: 1rem;
  }
  .case :global(strong) {
    font-weight: 500;
  }
  .case :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .case :global(li + li) {
    margin-top: 0.375rem;
  }
  .case :global(code) {
    overflow-wrap: anywhere;
  }
</style>
