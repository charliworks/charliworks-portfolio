---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import {
  formatPlayedAt,
  formatPlaytime,
  formatUpdated,
  getOffHours,
} from '../lib/off-hours';

const { sample, tracks, games } = await getOffHours();
const updated = new Date();

// Stand-in art for rows with no image: hero painting colours.
const TILES = [
  ['#e7835c', '#fbdca3'],
  ['#6c7b98', '#c49a92'],
  ['#7aa94e', '#e2e28c'],
  ['#2f5d8a', '#f4b26f'],
  ['#c8553a', '#f2c14e'],
  ['#3e6b30', '#86b553'],
];
const tile = (i: number) => {
  const [from, to] = TILES[i % TILES.length];
  return `background: linear-gradient(135deg, ${from}, ${to})`;
};
---

<Base
  title={`Off hours · ${site.name}`}
  description={`What ${site.name} listens to and plays away from the keyboard.`}
>
  <p>
    <a href="/">{site.name}</a>
  </p>
  <h1 class="mt-10 text-lg font-medium">Off hours</h1>
  <p class="mt-1 text-text-muted">
    What I listen to and play away from the keyboard.
  </p>
  {sample && (
    <p
      class="mt-1 text-sm text-text-muted"
      data-todo="TODO(charlito): sample data, see issue #29"
    >
      Sample data. My real Spotify and Steam activity comes soon.
    </p>
  )}

  <section class="mt-14" aria-labelledby="listening">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4">
      <h2 id="listening" class="font-medium">
        Listening
      </h2>
      <p class="text-sm text-text-muted">Recently played on Spotify</p>
    </div>
    <ol class="space-y-3">
      {tracks.map((track, i) => (
        <li class="reveal flex items-center gap-3">
          {track.image ? (
            <img
              src={track.image}
              alt=""
              width="48"
              height="48"
              loading="lazy"
              class="size-12 shrink-0 rounded-sm object-cover"
            />
          ) : (
            <div class="size-12 shrink-0 rounded-sm" style={tile(i)} />
          )}
          <div class="min-w-0">
            <p class="break-words">
              {track.url ? <a href={track.url}>{track.title}</a> : track.title}
            </p>
            <p class="text-sm text-text-muted">
              {track.artist} ·{' '}
              <time datetime={track.playedAt}>
                {formatPlayedAt(track.playedAt)}
              </time>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-14" aria-labelledby="playing">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4">
      <h2 id="playing" class="font-medium">
        Playing
      </h2>
      <p class="text-sm text-text-muted">Last two weeks on Steam</p>
    </div>
    <ul class="space-y-4">
      {games.map((game, i) => (
        <li class="reveal flex items-center gap-3">
          {game.image ? (
            <img
              src={game.image}
              alt=""
              width="92"
              height="43"
              loading="lazy"
              class="h-[43px] w-[92px] shrink-0 rounded-sm object-cover"
            />
          ) : (
            <div
              class="h-[43px] w-[92px] shrink-0 rounded-sm"
              style={tile(i + 3)}
            />
          )}
          <div class="min-w-0">
            <p class="break-words">
              {game.url ? <a href={game.url}>{game.name}</a> : game.name}
            </p>
            <p class="text-sm text-text-muted">
              <span class="inline-block">
                {formatPlaytime(game.minutesTwoWeeks)} in two weeks
              </span>{' '}
              ·{' '}
              <span class="inline-block">
                {formatPlaytime(game.minutesTotal)} total
              </span>
            </p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <p class="mt-14 text-sm text-text-muted">
    From Spotify and Steam. Updated{' '}
    <time datetime={updated.toISOString()}>{formatUpdated(updated)}</time>.
  </p>
</Base>
