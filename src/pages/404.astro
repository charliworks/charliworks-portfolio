---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base
  title={`Not found · ${site.name}`}
  description="This page does not exist."
  notFound
  phase={4}
  ride={{ from: 0.88, to: 0.9, km: 1 }}
  stop="Lost"
>
  <section class="lost" data-sky="4" data-stop="Lost">
    <h1 class="display lost-title">This page does not exist.</h1>
    <p class="lost-copy">
      The link may be old or mistyped. <a href="/">Go to the home page</a>.
    </p>
  </section>
</Base>

<style>
  .lost {
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 8rem clamp(1.25rem, 5vw, 4rem) 2rem;
    color: var(--cream);
  }

  .lost-title {
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-stretch: 130%;
    max-width: 16ch;
  }

  .lost-copy {
    margin-top: 1.5rem;
    font-size: 1.25rem;
  }
</style>
