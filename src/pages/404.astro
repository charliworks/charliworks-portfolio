---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base
  title={`Not found · ${site.name}`}
  description="This page does not exist."
  notFound
>
  <section class="lost">
    <h1 class="lost-title">This page does not exist.</h1>
    <p class="lost-copy">
      The link may be old or mistyped. <a href="/">Go to the home page</a>.
    </p>
  </section>
</Base>

<style>
  .lost {
    min-height: 55svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem clamp(1rem, 5vw, 4rem) 0;
  }

  .lost-title {
    max-width: 14ch;
    font-weight: 800;
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--pink);
  }

  .lost-copy {
    font-size: 1.25rem;
    color: var(--lavender);
  }
</style>
