---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ContactLinks from '../components/ContactLinks.astro';
import Parol from '../components/Parol.astro';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  /** The 404 page: no canonical URL, and search engines skip it. */
  notFound?: boolean;
}

const { title, description, image, notFound = false } = Astro.props;
const canonical = notFound
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  image
    ? (await getImage({ src: image, width: 1200, format: 'png' })).src
    : '/og.jpg',
  Astro.site,
);
const isHome = Astro.url.pathname === '/';
const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Experience', href: '/#experience' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '#contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b1b5e" />
    {canonical && <link rel="canonical" href={canonical} />}
    {notFound && <meta name="robots" content="noindex" />}
    <link
      rel="preload"
      href="/fonts/baloo2-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip">
      Skip to content
    </a>

    <header class="site-header">
      <a href="/" class="site-mark">
        <img src="/favicon.png" alt="" width="32" height="32" />
        <span class="sr-only">{site.name}, home</span>
      </a>
      <nav aria-label="Sections">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={isHome ? item.href.replace('/#', '#') : item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer id="contact" tabindex="-1" class="contact">
      <Parol size={6.5} drop={4} class="contact-parol" />
      <h2 class="contact-title">Say hi</h2>
      <ContactLinks />
      <p class="contact-foot">{site.name}</p>
    </footer>

    <script>
      import '../scripts/lanterns';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 50;
    padding: 0.5rem 0.9rem;
    border-radius: 10px;
    background: var(--yellow);
    color: var(--night);
    font-weight: 700;
    text-decoration: none;
  }

  .skip:focus {
    top: 1rem;
  }

  .site-header {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 1.25rem clamp(1rem, 5vw, 4rem) 0;
  }

  .site-mark img {
    display: block;
    border-radius: 8px;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .site-header nav a {
    text-decoration-color: transparent;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    text-decoration-color: var(--pink);
  }

  @media (max-width: 560px) {
    .site-header ul {
      gap: 0.25rem 0.9rem;
      font-size: 0.95rem;
    }
  }

  main:focus,
  footer:focus {
    outline: none;
  }

  /* ——— The close: under the biggest lantern ——— */
  .contact {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: clamp(4rem, 10vh, 6rem) clamp(1rem, 5vw, 4rem)
      clamp(3rem, 8vh, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  .contact-title {
    margin-top: 1.5rem;
    font-weight: 800;
    font-size: clamp(2.75rem, 9vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--pink);
  }

  .contact-foot {
    margin-top: clamp(3rem, 8vh, 5rem);
    font-size: var(--text-sm);
    color: var(--mist);
  }
</style>
