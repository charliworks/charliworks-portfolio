---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  /** The 404 page: no canonical URL, and search engines skip it. */
  notFound?: boolean;
}

const { title, description, image, notFound = false } = Astro.props;
const canonical = notFound
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  image
    ? (await getImage({ src: image, width: 1200, format: 'png' })).src
    : '/og.jpg',
  Astro.site,
);
const isHome = Astro.url.pathname === '/';
const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Experience', href: '/#experience' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '#contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeeaf6" />
    {canonical && <link rel="canonical" href={canonical} />}
    {notFound && <meta name="robots" content="noindex" />}
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip">
      Skip to content
    </a>

    <header class="site-header">
      <a href="/" class="site-mark">
        <img src="/favicon.png" alt="" width="32" height="32" />
        <span class="sr-only">{site.name}, home</span>
      </a>
      <nav aria-label="Sections">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={isHome ? item.href.replace('/#', '#') : item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer id="contact" tabindex="-1" class="contact">
      <h2 class="heading">Contact</h2>
      <div class="label">
        <div class="label-row">
          <span class="label-key mono">Send to</span>
          <span class="label-name">{site.name}</span>
          <span class="label-sub">Philippines · works remotely, anywhere</span>
        </div>
        <div class="label-row label-row--main">
          <ContactLinks />
        </div>
        <div class="label-foot">
          <span class="barcode" aria-hidden="true"></span>
          <span>Philippine time, UTC+8</span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/drive';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 50;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    background: var(--indigo);
    color: var(--on-indigo);
    font-weight: 700;
    text-decoration: none;
  }

  .skip:focus {
    top: 1rem;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding: 1.25rem clamp(1rem, 5vw, 3rem) 0;
  }

  .site-mark img {
    display: block;
    border-radius: 8px;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 1.5rem;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .site-header nav a {
    text-decoration-color: transparent;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    text-decoration-color: var(--action);
  }

  @media (max-width: 560px) {
    .site-header ul {
      gap: 0.25rem 0.9rem;
      font-size: 0.875rem;
    }
  }

  main:focus,
  footer:focus {
    outline: none;
  }

  /* ——— the close: a shipping label addressed to Charlito ——— */
  .contact {
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding: clamp(4.5rem, 12vh, 7rem) clamp(1rem, 5vw, 3rem)
      clamp(3rem, 8vh, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 4vh, 2.5rem);
  }

  .label {
    max-width: 46rem;
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: 14px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .label-row {
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem clamp(1rem, 3vw, 1.5rem);
    border-bottom: 2px solid var(--ink);
  }

  .label-key {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .label-name {
    font-weight: 900;
    font-stretch: 118%;
    font-size: clamp(1.4rem, 3.6vw, 2rem);
    line-height: 1.05;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .label-sub {
    color: var(--muted);
    font-weight: 600;
  }

  .label-row--main {
    padding-block: 1.4rem;
  }

  .label-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.9rem clamp(1rem, 3vw, 1.5rem);
    background: var(--card-soft);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
