---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../site';
import { skyAt } from '../scripts/phases';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  /** The 404 page: no canonical URL, and search engines skip it. */
  notFound?: boolean;
  /** Time of day the page opens at (index into the ride's phases). */
  phase?: number;
  /** This page's stretch of the road, 0–1, and its length in km. */
  ride?: { from: number; to: number; km: number };
  /** First odometer label. */
  stop?: string;
}

const {
  title,
  description,
  image,
  notFound = false,
  phase = 0,
  ride = { from: 0, to: 1, km: 18 },
  stop = '',
} = Astro.props;
const canonical = notFound
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  image
    ? (await getImage({ src: image, width: 1200, format: 'png' })).src
    : '/og.jpg',
  Astro.site,
);
const sky = skyAt(phase);
const isHome = Astro.url.pathname === '/';
const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Experience', href: '/#experience' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '#contact' },
];
---

<!doctype html>
<html
  lang="en"
  data-tone={phase < 0.5 ? 'day' : 'night'}
  style={`--sky-top:${sky.top};--sky-mid:${sky.mid};--sky-horizon:${sky.horizon}`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={sky.top} />
    {canonical && <link rel="canonical" href={canonical} />}
    {notFound && <meta name="robots" content="noindex" />}
    <link
      rel="preload"
      href="/fonts/anybody-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body
    data-phase={phase}
    data-ride-from={ride.from}
    data-ride-to={ride.to}
    data-ride-km={ride.km}
  >
    <a
      href="#main"
      class="sr-only rounded bg-cream px-3 py-2 text-ink focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>

    <div class="world" aria-hidden="true">
      <canvas data-ride></canvas>
    </div>

    <header class="site-header">
      <a href="/" class="site-mark">
        <img src="/favicon.png" alt="" width="28" height="28" />
        <span class="display">CJM</span>
        <span class="sr-only">{site.name}, home</span>
      </a>
      <nav aria-label="Sections">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={isHome ? item.href.replace('/#', '#') : item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <!-- Early in tab order: the stop control for the moving scene (WCAG 2.2.2). -->
    <button
      type="button"
      class="pause fade-up"
      style="--i:5"
      data-pause
      aria-pressed="false"
      hidden
    >
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <g class="icon-pause" fill="currentColor">
          <rect x="3.5" y="2.5" width="3" height="11" rx="1"></rect>
          <rect x="9.5" y="2.5" width="3" height="11" rx="1"></rect>
        </g>
        <path
          class="icon-play"
          d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8-5.2a.8.8 0 0 0 0-1.4l-8-5.2a.8.8 0 0 0-1.2.7Z"
          fill="currentColor"
        ></path>
      </svg>
      <span>Pause motion</span>
    </button>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer
      id="contact"
      tabindex="-1"
      class="contact"
      data-sky="4"
      data-stop="Contact"
    >
      <div class="contact-inner">
        <h2 class="display contact-title" data-rise>
          <span class="line">
            <span>Contact</span>
          </span>
        </h2>
        <ContactLinks />
        <p class="contact-foot">
          <span>{site.name}</span>
        </p>
      </div>
    </footer>

    <div class="hud" aria-hidden="true">
      <div class="odo">
        <span class="odo-km">
          <span data-odo-km>00.0</span> km
        </span>
        <span class="odo-stop" data-odo-stop>
          {stop}
        </span>
        <span class="odo-track">
          <span data-odo-bar></span>
        </span>
      </div>
    </div>

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 4vw, 3rem);
    color: var(--cream);
    transition:
      color 600ms var(--ease-out),
      transform 600ms var(--ease-out),
      opacity 400ms var(--ease-out);
  }

  /* Leaves faster than it returns. */
  .site-header:global(.is-away) {
    transform: translateY(-110%);
    opacity: 0;
    transition-duration: 300ms, 300ms, 200ms;
  }

  :global([data-tone='day']) .site-header {
    color: var(--ink);
  }

  .site-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .site-mark img {
    border-radius: 6px;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 1.4rem;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-header nav a {
    text-decoration-color: transparent;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    text-decoration-color: var(--accent);
  }

  /* Phones keep every section link: the wordmark steps back to the logo. */
  @media (max-width: 560px) {
    .site-mark .display {
      display: none;
    }

    .site-header {
      padding-inline: 1rem;
    }

    .site-header ul {
      gap: 0.25rem 0.9rem;
      font-size: 0.875rem;
    }
  }

  main:focus,
  footer:focus {
    outline: none;
  }

  /* ——— the close ——— */
  .contact {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 8rem clamp(1.25rem, 5vw, 4rem) 7rem;
    text-align: center;
  }

  .contact-inner {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
  }

  .contact-title {
    font-size: clamp(2.25rem, 14vw, 12rem);
    font-stretch: 140%;
    letter-spacing: -0.04em;
    color: var(--cream);
  }

  .contact-foot {
    margin-top: clamp(3rem, 8vh, 5rem);
    font-size: var(--text-sm);
    color: var(--haze);
  }

  /* ——— HUD ——— */
  .hud {
    position: fixed;
    left: clamp(1rem, 4vw, 3rem);
    bottom: 1.25rem;
    z-index: 20;
    color: var(--cream);
    transition: color 600ms var(--ease-out);
  }

  :global([data-tone='day']) .hud,
  :global([data-tone='day']) .pause {
    color: var(--ink);
  }

  .odo {
    display: grid;
    gap: 0.2rem;
    font-family: var(--font-display);
    font-stretch: 85%;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .odo-km {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .odo-km [data-odo-km] {
    color: var(--accent);
  }

  :global([data-tone='day']) .odo-km [data-odo-km] {
    color: var(--accent-day);
  }

  .odo-track {
    display: block;
    width: 7rem;
    height: 2px;
    background: color-mix(in srgb, currentColor 25%, transparent);
    overflow: hidden;
  }

  .odo-track span {
    display: block;
    height: 100%;
    background: var(--spark);
    transform-origin: left;
    transform: scaleX(0);
  }

  .pause {
    position: fixed;
    right: clamp(1rem, 4vw, 3rem);
    bottom: 1.25rem;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--cream);
    cursor: pointer;
    transition: color 600ms var(--ease-out);
  }

  .pause span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.24em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  }

  .pause:hover span {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .pause[hidden] {
    display: none;
  }

  /* The icon shows what a press will do next; the label keeps its width. */
  .pause .icon-play,
  .pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .pause[aria-pressed='true'] .icon-play {
    display: inline;
  }

  .pause span {
    display: inline-block;
    min-width: 6.6em;
    text-align: left;
  }

  /* Content scrolls beneath the HUD: a soft shadow keeps it readable. */
  .hud,
  .pause {
    text-shadow: 0 1px 14px rgb(8 10 30 / 0.55);
  }

  :global([data-tone='day']) .hud,
  :global([data-tone='day']) .pause {
    text-shadow: 0 1px 14px rgb(253 225 168 / 0.8);
  }

  @media (max-width: 1023px) {
    .odo-stop,
    .odo-track {
      display: none;
    }
  }
</style>
