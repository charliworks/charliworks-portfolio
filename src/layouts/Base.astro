---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ContactLinks from '../components/ContactLinks.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  /** The 404 page: no canonical URL, and search engines skip it. */
  notFound?: boolean;
}

const { title, description, image, notFound = false } = Astro.props;
const canonical = notFound
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(
  image
    ? (await getImage({ src: image, width: 1200, format: 'png' })).src
    : '/og.jpg',
  Astro.site,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {notFound && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4"
    >
      Skip to content
    </a>
    <div class="mx-auto max-w-(--measure) px-5 pt-16 pb-16 sm:pt-24">
      <main id="main">
        <slot />
      </main>
      <footer class="mt-16">
        <h2 class="mb-3 font-medium">Contact</h2>
        <ContactLinks />
      </footer>
    </div>
  </body>
</html>
